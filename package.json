{
  "name": "ehh-monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "mobile"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:mobile": "npm run start --workspace=mobile",
    "dev": "concurrently -n \"BACKEND,FRONTEND,MOBILE\" -c \"blue,magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:mobile\"",
    "start:all": "npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "4.17.41",
    "@types/serve-static": "1.15.5"
  }
}
